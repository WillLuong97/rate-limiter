module(
    name = "aegis-engine-main",
    version = "1.0", 
)

bazel_dep(name = "boost.program_options", version = "1.89.0.bcr.1")
bazel_dep(name = "boost.filesystem", version = "1.89.0.bcr.1")
bazel_dep(name = "boost.system", version = "1.89.0.bcr.1")
bazel_dep(name = "boost.algorithm", version = "1.89.0.bcr.1")
bazel_dep(name = "boost.asio", version = "1.89.0.bcr.1")
bazel_dep(name = "boost.thread", version = "1.89.0.bcr.1")
bazel_dep(name = "googletest", version = "1.14.0")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "rules_proto",     version = "6.0.0")   # proto_library rule
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.8.0")  # cpp_grpc_library rule
bazel_dep(name = "hiredis", version = "1.3.0") 
bazel_dep(name = "redis_plus_plus")

# ── gRPC and protobuf ─────────────────────────────────────────────────────────
bazel_dep(name = "grpc", version = "1.73.1")
single_version_override(module_name = "grpc", version = "1.73.1")
bazel_dep(name = "protobuf", version = "30.0")
bazel_dep(name = "envoy_api", version = "0.0.0-20250128-4de3c74")
bazel_dep(name = "protoc-gen-validate", version = "1.2.1.bcr.1", repo_name = "com_envoyproxy_protoc_gen_validate")
bazel_dep(name = "xds", version = "0.0.0-20240423-555b57e", repo_name = "com_github_cncf_xds")

local_path_override(
    module_name = "redis_plus_plus",
    path = "third_party/redis_plus_plus",
)
